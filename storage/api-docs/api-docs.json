{
    "openapi": "3.0.0",
    "info": {
        "title": "Sistema de Ponto AQUICOB — API REST",
        "description": "REST API do **Sistema de Ponto Eletrónico** (AQUICOB).\n\n### Autenticação\nOs endpoints registados em `routes/api.php` estão **públicos** (sem token nem sessão) nesta versão de demonstração. **Em produção** deve proteger-se a API (por exemplo [Laravel Sanctum](https://laravel.com/docs/sanctum) ou um API gateway).\n\n### Convenções\n- Pedidos com corpo: `Content-Type: application/json`.\n- Respostas de recurso ou lista seguem o envelope Laravel: `{\"data\": ...}`.\n- Erros de validação: HTTP `422` com `message` e objeto `errors` por campo.\n\n### Funcionários (`/api/employees`)\n- Na **API**, ao criar um funcionário o papel é sempre **colaborador**; o campo `role` no JSON é **proibido** (`422` se enviado).\n- Na **atualização** pela API, `role` também é proibido.\n- O CPF é armazenado com 11 dígitos; na API pode enviar-se com ou sem máscara; nas respostas devolve-se mascarado.",
        "contact": {
            "name": "AQUICOB",
            "email": "admin@exemplo.com"
        },
        "license": {
            "name": "MIT"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "URL base da aplicação. Os paths abaixo incluem o prefixo `/api` (Laravel `routes/api.php`)."
        }
    ],
    "paths": {
        "/api/employees": {
            "get": {
                "tags": [
                    "Employees"
                ],
                "summary": "Lista todos os funcionários",
                "description": "Devolve todos os registos ordenados por nome. Sem paginação.",
                "operationId": "7fc06f144c1cd7925c5c391a6609f02d",
                "responses": {
                    "200": {
                        "description": "Lista retornada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Employee"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Employees"
                ],
                "summary": "Cadastra um funcionário",
                "description": "Cria um funcionário com papel **colaborador**. O campo `role` no corpo é rejeitado pela API.",
                "operationId": "bfad4edec29b0edbd684a0afbd847510",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StoreEmployeeBody"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Funcionário criado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Employee"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Erro de validação (CPF inválido, duplicado, `role` enviado, etc.)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "errors": {
                                            "type": "object",
                                            "additionalProperties": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/employees/{employee}": {
            "get": {
                "tags": [
                    "Employees"
                ],
                "summary": "Obtém um funcionário pelo id",
                "description": "O parâmetro de rota `employee` é o identificador numérico (chave primária).",
                "operationId": "7be3df7eb2d9c301e74a7f9160f44383",
                "parameters": [
                    {
                        "name": "employee",
                        "in": "path",
                        "description": "ID do funcionário",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Recurso encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Employee"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Nenhum funcionário com o id indicado"
                    }
                }
            },
            "put": {
                "tags": [
                    "Employees"
                ],
                "summary": "Atualiza um funcionário",
                "description": "Atualização parcial: envie apenas os campos a alterar. Palavra-passe opcional (mínimo 8 caracteres com regras Laravel). O campo `role` é rejeitado pela API.",
                "operationId": "ff9ab641fc6320c1ad01c01b9b05d536",
                "parameters": [
                    {
                        "name": "employee",
                        "in": "path",
                        "description": "ID do funcionário",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateEmployeeBody"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Atualizado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Employee"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Nenhum funcionário com o id indicado"
                    },
                    "422": {
                        "description": "Erro de validação",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "errors": {
                                            "type": "object",
                                            "additionalProperties": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Employees"
                ],
                "summary": "Remove um funcionário",
                "description": "Resposta sem corpo em caso de sucesso.",
                "operationId": "e225f5026a067ec74f6b45726f29e617",
                "parameters": [
                    {
                        "name": "employee",
                        "in": "path",
                        "description": "ID do funcionário",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Removido com sucesso (sem conteúdo)"
                    },
                    "404": {
                        "description": "Nenhum funcionário com o id indicado"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "StoreEmployeeBody": {
                "required": [
                    "name",
                    "password",
                    "cpf",
                    "position"
                ],
                "properties": {
                    "name": {
                        "description": "Nome completo (letras, até 120 caracteres)",
                        "type": "string",
                        "example": "Maria Silva",
                        "maxLength": 120
                    },
                    "password": {
                        "description": "Mínimo 8 caracteres (regras `Password` do Laravel)",
                        "type": "string",
                        "format": "password",
                        "example": "SenhaSegura!1"
                    },
                    "password_confirmation": {
                        "description": "Deve coincidir com `password`",
                        "type": "string",
                        "format": "password"
                    },
                    "cpf": {
                        "description": "11 dígitos ou com máscara; dígitos verificadores válidos",
                        "type": "string",
                        "example": "529.982.247-25"
                    },
                    "position": {
                        "description": "Cargo",
                        "type": "string",
                        "example": "Atendente",
                        "maxLength": 255
                    },
                    "role": {
                        "description": "**Proibido na API** (422). Apenas na criação pela área web admin.",
                        "type": "string",
                        "example": "colaborador",
                        "enum": [
                            "admin",
                            "colaborador"
                        ]
                    }
                },
                "type": "object"
            },
            "UpdateEmployeeBody": {
                "description": "Corpo parcial (atualização). Todos os campos são opcionais; envie apenas o que pretende alterar. Na **API**, o campo `role` é **proibido**.",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Maria Silva Santos",
                        "maxLength": 120
                    },
                    "password": {
                        "description": "Se enviado, mínimo 8 caracteres e exige `password_confirmation`",
                        "type": "string",
                        "format": "password"
                    },
                    "password_confirmation": {
                        "type": "string",
                        "format": "password"
                    },
                    "cpf": {
                        "description": "11 dígitos ou com máscara",
                        "type": "string",
                        "example": "529.982.247-25"
                    },
                    "position": {
                        "type": "string",
                        "example": "Supervisora",
                        "maxLength": 255
                    },
                    "role": {
                        "description": "**Proibido na API** (422).",
                        "type": "string",
                        "enum": [
                            "admin",
                            "colaborador"
                        ]
                    }
                },
                "type": "object"
            },
            "Employee": {
                "title": "Funcionário",
                "description": "Recurso devolvido em `data` (objeto ou lista).",
                "properties": {
                    "id": {
                        "description": "Chave primária",
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "description": "Nome completo (único na base de dados)",
                        "type": "string",
                        "example": "Maria Silva"
                    },
                    "cpf": {
                        "description": "CPF mascarado (xxx.xxx.xxx-xx)",
                        "type": "string",
                        "example": "529.982.247-25"
                    },
                    "position": {
                        "description": "Cargo ou função",
                        "type": "string",
                        "example": "Atendente"
                    },
                    "role": {
                        "description": "Papel: `admin` ou `colaborador`",
                        "type": "string",
                        "example": "colaborador",
                        "enum": [
                            "admin",
                            "colaborador"
                        ]
                    },
                    "created_at": {
                        "description": "ISO 8601",
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "description": "ISO 8601",
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Employees",
            "description": "CRUD de funcionários (também usado pela área web admin; nesta documentação apenas os contratos HTTP da API JSON)."
        }
    ],
    "externalDocs": {
        "description": "Interface Swagger UI (explorar e testar a API no browser)",
        "url": "/api/documentation"
    }
}